# Copy to .env for local development. Leave DATABASE_URL unset to start
# a bundled Postgres on PG_PORT (default 4842).
# DATABASE_URL=postgres://merdienz:merdienz@127.0.0.1:4842/merdienz
PG_PORT=4842
PORT=4840

# Runtime mode: cloud (the process default, fail-closed), selfhosted, or dev.
# Leave this commented to use the fail-closed default. Do not copy a dev
# override into a real deployment.
# MERDIENZ_MODE=cloud

# Primary process talks to the second probe with PROBE_B_SECRET.
# The probe process itself reads PROBE_B_HMAC_SECRET. Set them to the
# same 32-byte-or-longer value. There is no default secret.
# In cloud mode the primary also requires an https PROBE_B_URL and
# PROBE_B_SPKI_SHA256 (SHA-256 of the probe certificate SPKI, hex or base64).
# PROBE_B_URL=https://127.0.0.1:7801/internal/probe
# PROBE_B_SECRET= # gitleaks:allow
# PROBE_B_HMAC_SECRET= # gitleaks:allow
# PROBE_B_SPKI_SHA256=
# PROBE_B_TLS_CERT=/path/to/probe-cert.pem
# PROBE_B_TLS_KEY=/path/to/probe-key.pem
PROBE_B_MAX_SKEW_SEC=60
PROBE_B_PORT=7801
# HOST=0.0.0.0

# Signed cookies / CSRF for later cookie-based sessions.
# COOKIE_SECRET= # gitleaks:allow

# Self-hosted/dev only. Never enabled by default. Ignored in cloud mode.
# ALLOW_PRIVATE_TARGETS=true

# Comma-separated proxy addresses allowed to set X-Forwarded-For on /ping.
# TRUSTED_PROXIES=127.0.0.1

# Dead-man: the scheduler GETs this URL after every cycle. Leave unset to skip.
# HEARTBEAT_URL=https://example.invalid/ping

# Email: dev (in-memory, for tests), console (log only), smtp, or none.
# Production refuses dev and console. Cloud starts at none until SMTP is set.
MAIL_TRANSPORT=dev
MAIL_FROM=alerts@localhost
# Cloud mode locks MAIL_FROM to a merdienz.com address (default alert@merdienz.com when SMTP is on).
# Self-hosted mode must set MAIL_FROM to an address on your domain when using smtp; a missing value is refused.
# SMTP relay. There is no built-in relay; SMTP_HOST defaults to localhost.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# The SMTP password is read from a file (needed only when SMTP_USER is set).
# MERDIENZ_SMTP_PASSWORD_FILE=/etc/merdienz/smtp-password
# Optional: refuse to start in production unless SMTP_HOST equals this value.
# SMTP_REQUIRED_HOST=

SCHEDULER_INTERVAL_MS=5000
# Alert delivery (retries and prune) runs on its own loop so a slow mail
# send cannot delay site checks or heartbeat evaluation.
# ALERT_DELIVERY_INTERVAL_MS=5000
DEFAULT_TIMEOUT_MS=10000

# Public base URL used in heartbeat snippets. Defaults to http://127.0.0.1:$PORT
# PUBLIC_URL=http://127.0.0.1:4840

# Stripe TEST billing. Leave unset to keep billing disabled.
# Secret and webhook values live in files, not in this env file.
# MERDIENZ_STRIPE_SECRET_KEY_FILE=/etc/merdienz-cloud/stripe-secret
# MERDIENZ_STRIPE_WEBHOOK_SECRET_FILE=/etc/merdienz-cloud/stripe-webhook-secret
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=

# Cloud service: skip migrate() at boot. Run migrations as merdienz_owner
# with `node src/migrate-cli.js`.
# MERDIENZ_SKIP_MIGRATIONS=1
#
# First-run setup token path (the process appends a unique suffix).
# MERDIENZ_SETUP_TOKEN_FILE=/var/lib/merdienz/setup-token

# SSL, domain, and SEO checks (see README). Domain expiry uses RDAP and is off by default.
# DOMAIN_EXPIRY_LOOKUP=off
# RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# SEO_CHECKS=on
# INSIGHTS_PER_TICK=5
